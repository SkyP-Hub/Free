local function ser(v, d, max, ind)
  local t = type(v)
  if t == "string" then return '"' .. v:sub(1, 50) .. '"' end
  if t == "function" then
    local n = "?"
    pcall(function() local i = debug.getinfo(v); n = tostring(i.name or "?") .. "/" .. tostring(i.numparams) end)
    return "fn<" .. n .. ">"
  end
  if t ~= "table" then return tostring(v) end
  if d >= max then return "{...}" end
  local keys = {}
  for k in pairs(v) do keys[#keys + 1] = k end
  table.sort(keys, function(a, b) return tostring(a) < tostring(b) end)
  local parts = {}
  for i, k in ipairs(keys) do
    if i > 25 then parts[#parts + 1] = ind .. "  ...(+" .. (#keys - 25) .. " lagi)" break end
    local okv, sv = pcall(ser, v[k], d + 1, max, ind .. "  ")
    parts[#parts + 1] = ind .. "  " .. tostring(k) .. " = " .. (okv and sv or "?")
  end
  return "{\n" .. table.concat(parts, "\n") .. "\n" .. ind .. "}"
end

btn("Dump weather", 110, function()
  if type(getloadedmodules) ~= "function" then show("Tidak ada getloadedmodules") return end
  local mods = {}
  for _, m in ipairs(getloadedmodules()) do mods[m.Name] = m end
  local function get(n)
    local m = mods[n]
    if not m then return nil end
    local ok, v = pcall(require, m)
    return ok and v or nil
  end
  local out = {}
  local function add(title, fn)
    local ok, r = pcall(fn)
    out[#out + 1] = "=== " .. title .. " ===\n" .. (ok and tostring(r) or ("ERR " .. tostring(r)))
  end

  local W = get("geEA0CTgC")
  add("geEA0CTgC definisi weather", function()
    local ks = {}
    for k in pairs(W) do ks[#ks + 1] = tostring(k) end
    local s = { "jumlah key: " .. #ks .. "\ncontoh: " .. table.concat(ks, ",", 1, math.min(#ks, 40)) }
    for _, id in ipairs({ 984, 1364, 1750, 3252 }) do
      s[#s + 1] = id .. " = " .. ser(W[id] or W[tostring(id)], 0, 3, "")
    end
    return table.concat(s, "\n")
  end)

  local M = get("iSkJ5LWYh")
  add("iSkJ5LWYh (MOODS) isi atas", function() return ser(M, 0, 2, "") end)
  add("MOODS.snow detail", function() return ser(M.MOODS.snow, 0, 3, "") end)

  local N = get("tKaaiho5wz")
  add("tKaaiho5wz (net) weather", function()
    return "EVENTS.WeatherChanged = " .. ser(N.EVENTS.WeatherChanged, 0, 2, "")
      .. "\nNOTE[9] = " .. ser(N.NOTE[9], 0, 2, "")
      .. "\nCALLS.EditWeather = " .. ser(N.CALLS.EditWeather, 0, 2, "")
      .. "\nASK[19] = " .. ser(N.ASK[19], 0, 2, "")
      .. "\nkey atas: " .. ser(N, 0, 1, "")
  end)

  local I = get("eR8DWXu5AEWq")
  add("eR8DWXu5AEWq item weather", function()
    return "934 = " .. ser(I[934], 0, 2, "") .. "\n984 = " .. ser(I[984], 0, 2, "") .. "\n932 = " .. ser(I[932], 0, 2, "")
  end)

  local text = table.concat(out, "\n\n")
  if hasFS then pcall(writefile, "Fian/weather_dump3.txt", text) end
  show(text)
end)
