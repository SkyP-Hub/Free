local function parse(msg)
    if type(msg) ~= "string" then return nil end
    local pre = P.Prefix ~= "" and P.Prefix or "/"
    if string.sub(msg, 1, #pre) ~= pre then return nil end
    local name, rest = string.match(string.sub(msg, #pre + 1), "^(%S+)%s*(.*)$")
    if not name then return nil end
    name = string.lower(name)
    local fn = CMDS[name]
    if not fn then return nil end
    local args = {}
    for w in string.gmatch(rest, "%S+") do args[#args + 1] = w end
    return fn, args, name
end

local function run(msg)
    local fn, args, name = parse(msg)
    if not fn then return say("Perintah tidak dikenal: " .. tostring(msg) .. "  (/help)") end
    if P.Busy then return say("Tunggu, perintah sebelumnya belum selesai") end
    if not Ref.World then return say("Belum terhubung ke game (tekan Hubungkan ulang)") end
    P.Busy = true
    P.Ran += 1
    task.spawn(function()
        local ok, err = pcall(fn, args)
        P.Busy = false
        if not ok then say("Error /" .. name .. ": " .. tostring(err)) end
    end)
end

do
    local okH, errH = pcall(function()
        if type(hookmetamethod) ~= "function" or type(getnamecallmethod) ~= "function" then
            error("executor tidak punya hookmetamethod")
        end
        local wrapC = type(newcclosure) == "function" and newcclosure or function(f) return f end
        local isOurs = type(checkcaller) == "function" and checkcaller or function() return false end
        local old
        old = hookmetamethod(game, "__namecall", wrapC(function(self, ...)
            if P.alive and P.On and not isOurs() and getnamecallmethod() == "SendAsync"
                and typeof(self) == "Instance" and self.ClassName == "TextChannel" then
                local msg = ...
                if parse(msg) then
                    task.spawn(run, msg)
                    return nil -- tidak dikirim ke server
                end
            end
            return old(self, ...)
        end))
    end)
    P.Hooked = okH
    if not okH then P.HookErr = (tostring(errH):gsub("^.-:%d+: ", "")) end
end

