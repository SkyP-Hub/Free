function Auto.treeShape(t)
local w = Refs.World
if type(t) ~= "table" or not w or t == w or rawget(t, "fg") ~= nil then return nil end
local W, H = w.w, w.h
local okT, st = pcall(function() return workspace:GetServerTimeNow() end)
