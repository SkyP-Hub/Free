local function itemName(id)
    local it = ItemDB[id]
    return (it and it.name) or ("Item #" .. tostring(id))
end

local function invCount(id)
    if not Ref.Inv then return 0 end
    local ok, n = pcall(function() return Ref.Inv:count(id) end)
    return (ok and type(n) == "number") and n or 0
end

local function playerState()
    if not Ref.State then return nil end
    local ok, s = pcall(Ref.State)
    if ok and type(s) == "table" and type(s.x) == "number" and type(s.y) == "number" and s.active ~= false then
        return s
    end
    return nil
end

local function here() -- tile tempat berdiri
    local s = playerState()
    if not s then return nil end
    return floor(s.x), floor(s.y - 0.475)
end

local function worldName()
    local w = Ref.World
    local n = w and rawget(w, "name")
    return type(n) == "string" and n or nil
end

local function worldChannel()
    local folder = TextChatService:FindFirstChild("WorldChannels")
    if not folder then return nil end
    local name = worldName()
    if name then
        local ch = folder:FindFirstChild(name)
        if ch then return ch end
    end
    for _, ch in ipairs(folder:GetChildren()) do
        if ch:IsA("TextChannel") then
            for _, src in ipairs(ch:GetChildren()) do
                if src:IsA("TextSource") and src.UserId == LocalPlayer.UserId then return ch end
            end
        end
    end
    return nil
end

local function worldCall(...)
    local w = Ref.World
    local f = w and rawget(w, "call")
    if type(f) ~= "function" then return false end
    return pcall(f, ...)
end

local function gemsNow()
    local g = Ref.Gems
    local f = g and rawget(g, "addGems")
    if type(f) ~= "function" then return nil end
    for _, v in pairs(getUpvalues(f)) do
        if type(v) == "number" then return v end
    end
    return nil
end

local function dropsList()
    local w = Ref.World
    local dl = w and rawget(w, "dropList")
    if type(dl) == "function" then
        local ok, l = pcall(dl)
        if ok and type(l) == "table" then return l end
    end
    local wd = w and rawget(w, "dropTaken")
    if type(wd) == "function" then
        for _, u in pairs(getUpvalues(wd)) do
            if type(u) == "table" then
                local first = rawget(u, 1)
                if type(first) == "table" and rawget(first, "uid") ~= nil then return u end
            end
        end
    end
    return {}
end

-- ---------- tombol gerak (dibungkus dari WorldMenu.isDown game) ----------
local Input = { active = false, left = false, right = false, jump = false }
local OrigIsDown, OurIsDown = nil, nil
local function hookMove()
    local M = Mod.Menu
    if not M or OrigIsDown then return end
    local cur = rawget(M, "isDown")
    if type(cur) ~= "function" then return end
    OrigIsDown = cur
    OurIsDown = function(saved, key, ...)
        if P.alive and Input.active then
            if key == "keyLeft" then return Input.left end
            if key == "keyRight" then return Input.right end
            if key == "keyJump" then return Input.jump end
        end
        return OrigIsDown(saved, key, ...)
    end
    M.isDown = OurIsDown
end
local function unhookMove()
    local M = Mod.Menu
    if M and OrigIsDown and rawget(M, "isDown") == OurIsDown then M.isDown = OrigIsDown end
end
local function release()
    Input.left, Input.right, Input.jump = false, false, false
end

-- jalan lurus ke kolom tx (satu lantai)
local function walkToX(tx, ty, maxSec)
    if not OrigIsDown then return false, "kontrol gerak game tidak ketemu" end
    local s = playerState()
    if not s then return false, "posisi karakter tidak terbaca" end
    if abs(floor(s.y - 0.475) - ty) > 1 then return false, "posisi beda lantai (harus satu lantai)" end
    Input.active = true
    release()
    local t0, lastX, lastMove = os.clock(), s.x, os.clock()
    local settled = 0
    while P.alive and os.clock() - t0 < (maxSec or 12) do
        s = playerState()
        if not s then break end
        local dx = (tx + 0.5) - s.x
        if abs(dx) < 0.22 then
            release()
            settled += 1
            if settled >= 6 then break end -- diam sebentar supaya tidak meluncur
        else
            settled = 0
            Input.right, Input.left = dx > 0, dx < 0
            if abs(s.x - lastX) > 0.02 then lastMove = os.clock() end
            Input.jump = os.clock() - lastMove > 0.45 -- tertahan: lompat
        end
        lastX = s.x
        task.wait()
    end
    release()
    task.wait(0.1)
    Input.active = false
    s = playerState()
    return s ~= nil and abs((tx + 0.5) - s.x) < 0.5, "tidak sampai (terhalang?)"
end

-- drop di depan karakter
local function dropHere(id, n)
    local hud = Ref.Hud
    local f = hud and rawget(hud, "onDrop")
    if type(f) ~= "function" then return 0, "fungsi drop game tidak ketemu (tekan Hubungkan ulang)" end
    local have = invCount(id)
    if have <= 0 then return 0, "tidak punya " .. itemName(id) end
    if have < n then return 0, ("%s kurang: punya %d, perlu %d"):format(itemName(id), have, n) end
    local left, flipped = n, false
    while left > 0 and P.alive do
        local before = invCount(id)
        pcall(f, id, math.min(left, 200))
        task.wait(0.7) -- game menolak drop yang terlalu cepat
        local got = before - invCount(id)
        if got > 0 then
            left -= got
        elseif not flipped and OrigIsDown then
            -- di depan tembok: hadap ke arah lain lalu coba lagi
            flipped = true
            local s = playerState()
            local right = s and (s.facing or 1) < 0
            Input.active = true
            Input.right, Input.left = right, not right
            task.wait(0.06)
            release()
            Input.active = false
            task.wait(0.3)
        else
            return n - left, "tidak bisa drop di posisi ini"
        end
    end
    return n - left, nil
end

-- 100 WL -> DL, 100 DL -> BGL (sama seperti tombol convert di game)
local function convertUp()
    local inv = Ref.Inv
    if not inv then return 0 end
    local done = 0
    for _, step in ipairs({ { 242, 1796 }, { 1796, 7188 } }) do
        local from, to = step[1], step[2]
        local guard = 0
        while invCount(from) >= 100 and invCount(to) < 200 and guard < 50 do
            guard += 1
            pcall(function()
                inv:remove(from, 100)
                inv:add(to, 1)
            end)
            local ok = worldCall("ConvertLock", from, to)
            if not ok then break end
            done += 1
            task.wait(0.35)
        end
    end
    return done
end

local function findItemIds(q)
    q = string.lower(q)
    local exact = tonumber(q)
    if exact and ItemDB[exact] then return { exact } end
    local out = {}
    for id, it in pairs(ItemDB) do
        if type(it.name) == "string" and string.find(string.lower(it.name), q, 1, true) then out[#out + 1] = id end
    end
    table.sort(out, function(a, b) return #itemName(a) < #itemName(b) end)
    return out
end

local function splitWL(total)
    total = math.max(0, floor(total))
    return total // 10000, (total % 10000) // 100, total % 100
end
local function wlText(total)
    local b, d, w = splitWL(total)
    local parts = {}
    if b > 0 then parts[#parts + 1] = b .. " BGL" end
    if d > 0 then parts[#parts + 1] = d .. " DL" end
    if w > 0 or #parts == 0 then parts[#parts + 1] = w .. " WL" end
    return table.concat(parts, " + ")
end
local function num(s)
    local n = tonumber(s)
    if not n then return nil end
    n = floor(n)
    return n > 0 and n or nil
end

