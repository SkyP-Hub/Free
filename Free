local Mod = { Menu = nil, Inventory = nil }
local Ref = { World = nil, Inv = nil, State = nil, Gems = nil, Hud = nil }
local ItemDB = {}

local function field(t, k)
    local ok, v = pcall(function() return t[k] end)
    return ok and v or nil
end
local function isFn(t, k) return type(field(t, k)) == "function" end

local function getUpvalues(fn)
    local gu = (debug and debug.getupvalues) or getupvalues
    if type(gu) ~= "function" then return {} end
    local ok, t = pcall(gu, fn)
    return (ok and type(t) == "table") and t or {}
end

-- fungsi milik game (bukan executor / bukan inti Roblox)
local function isGameFn(fn)
    if isexecutorclosure then
        local ok, res = pcall(isexecutorclosure, fn)
        if ok and res then return false end
    end
    local ok, src = pcall(debug.info, fn, "s")
    if ok and type(src) == "string"
        and (string.find(src, "CoreGui", 1, true) or string.find(src, "CorePackages", 1, true)) then
        return false
    end
    return true
end

local function fillItems(src)
    if type(src) ~= "table" then return 0 end
    local n = 0
    pcall(function()
        for k, v in pairs(src) do
            if type(v) == "table" and type(rawget(v, "name")) == "string" then
                local id = (type(rawget(v, "id")) == "number" and v.id) or tonumber(k)
                if id then ItemDB[id] = v n += 1 end
            end
        end
    end)
    return n
end

local function itemCount()
    local n = 0
    for _ in pairs(ItemDB) do n += 1 end
    return n
end

local function scanModules()
    if type(getloadedmodules) ~= "function" then return end
    local needItems = itemCount() < 500
    local okM, mods = pcall(getloadedmodules)
    if not okM or type(mods) ~= "table" then return end
    for _, m in ipairs(mods) do
        local ok, v = pcall(require, m)
        if ok and type(v) == "table" then
            if not Mod.Menu and isFn(v, "isDown") and field(v, "KEYS") ~= nil then
                Mod.Menu = v
            elseif not Mod.Inventory and isFn(v, "room") and isFn(v, "used") and isFn(v, "count") and isFn(v, "add")
                and isFn(v, "new") then
                Mod.Inventory = v
            elseif needItems then
                -- data item (bisa dipecah jadi beberapa potongan / sub-tabel)
                fillItems(v)
                pcall(function()
                    for _, sub in pairs(v) do
                        if type(sub) == "table" then fillItems(sub) end
                    end
                end)
            end
        end
    end
end

local function checkTable(x)
    if not Ref.World then
        local fg, bg = rawget(x, "fg"), rawget(x, "bg")
        if type(fg) == "table" and type(bg) == "table"
            and (type(rawget(x, "call")) == "function" or type(rawget(x, "dropList")) == "function") then
            Ref.World = x
            return true -- isi world (grid besar) tidak ditelusuri
        end
    end
    if not Ref.Inv and type(rawget(x, "slots")) == "table" and rawget(x, "capacity") ~= nil
        and type(x.count) == "function" and type(x.room) == "function" and type(x.remove) == "function" then
        Ref.Inv = x
    end
    if not Ref.State then
        local fn = rawget(x, "state")
        if type(fn) == "function" then
            local function good(s)
                return type(s) == "table" and type(s.x) == "number" and type(s.y) == "number" and s.facing ~= nil
            end
            local ok, s = pcall(fn)
            if ok and good(s) then
                Ref.State = fn
            else
                ok, s = pcall(fn, x)
                if ok and good(s) then Ref.State = function() return fn(x) end end
            end
        end
    end
    if not Ref.Gems and type(rawget(x, "addGems")) == "function" then Ref.Gems = x end
    if not Ref.Hud and type(rawget(x, "handPower")) == "function"
        and (type(rawget(x, "punchRange")) == "function" or type(rawget(x, "buildRange")) == "function") then
        Ref.Hud = x
    end
    return false
end

local function refsDone()
    return Ref.World and Ref.Inv and Ref.State and Ref.Gems and Ref.Hud
end

-- 1) getgc
local function scanGc()
    if type(getgc) ~= "function" then return end
    local okG, list = pcall(getgc, true)
    if not okG or type(list) ~= "table" then return end
    for i, v in ipairs(list) do
        if i % 4000 == 0 then task.wait() end
        if type(v) == "table" then pcall(checkTable, v) end
        if refsDone() then break end
    end
end

-- 2) cadangan (Delta): telusuri fungsi loop game lewat getconnections + upvalue
local function scanLoops()
    if type(getconnections) ~= "function" then return end
    local seen, queue, qi, nodes = {}, {}, 1, 0
    local function push(x)
        if not seen[x] then seen[x] = true queue[#queue + 1] = x end
    end
    for _, name in ipairs({ "RenderStepped", "Heartbeat", "Stepped", "PreRender", "PreSimulation", "PostSimulation" }) do
        local okS, sig = pcall(function() return RunService[name] end)
        if okS and sig then
            local ok, conns = pcall(getconnections, sig)
            if ok and type(conns) == "table" then
                for _, c in ipairs(conns) do
                    local okf, fn = pcall(function() return c.Function end)
                    if okf and type(fn) == "function" and isGameFn(fn) then push(fn) end
                end
            end
        end
    end
    while qi <= #queue and nodes < 60000 and not refsDone() do
        local x = queue[qi]
        qi += 1
        nodes += 1
        if nodes % 1500 == 0 then task.wait() end
        if type(x) == "function" then
            if not (iscclosure and iscclosure(x)) then
                for _, u in pairs(getUpvalues(x)) do
                    local tu = type(u)
                    if tu == "table" or tu == "function" then push(u) end
                end
            end
        elseif type(x) == "table" then
            pcall(function()
                if checkTable(x) then return end
                local n = 0
                for _, v in next, x do
                    n += 1
                    if n > 600 then break end
                    local tv = type(v)
                    if tv == "table" or tv == "function" then push(v) end
                end
            end)
        end
    end
end

local function connect()
    scanModules()
    if not refsDone() then scanGc() end
    if not refsDone() then scanLoops() end
    return Ref.World ~= nil
end

local function refsText()
    local function s(v) return v and "OK" or "TIDAK" end
    return ("World %s | Tas %s | Posisi %s | Drop %s | Gems %s | Gerak %s | Item %d"):format(
        s(Ref.World), s(Ref.Inv), s(Ref.State), s(Ref.Hud and rawget(Ref.Hud, "onDrop")), s(Ref.Gems),
        s(Mod.Menu), itemCount())
end

