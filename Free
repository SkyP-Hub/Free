Vend.Status = ("Ke vending (%d,%d): tambah %s x%d"):format(m.x, m.y, itemName(id), n)
if Vend.goTo(m) then
if Vend.call("stock", m.x, m.y, id, n) then
selling[id] = true
if Vend.Picked[id] then
