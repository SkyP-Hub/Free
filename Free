if okf then addFn(fn) end
end
end
end
end
local i = 1
while i <= #queue and nF < 1500 do
local fn = queue[i]
i += 1
if not seenF[fn] then
seenF[fn] = true
nF += 1
for _, u in pairs(getUpvalues(fn)) do
if type(u) == "table" then
if tryTable(u) then return true end
elseif type(u) == "function" then
