for _, st in ipairs(route) do
if not closed[st.y * w.w + st.x] then bad[#bad + 1] = st end
end
if #bad < #route then
local now = os.clock()
for _, st in ipairs(bad) do Pabrik.Bad[st.key] = now + 300 end
end
end
end
end
