local function draggable(handle, target)
    local dragging, startPos, startInput
    handle.InputBegan:Connect(function(io)
        if io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.Touch then
            dragging, startPos, startInput = true, target.Position, io.Position
            io.Changed:Connect(function()
                if io.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    table.insert(P.conns, UserInputService.InputChanged:Connect(function(io)
        if dragging and (io.UserInputType == Enum.UserInputType.MouseMovement or io.UserInputType == Enum.UserInputType.Touch) then
            local d = io.Position - startInput
            target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end))
end
