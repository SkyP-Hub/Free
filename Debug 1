local snap
local function snapshot()
  local s = {}
  local function pathOf(o)
    local parts, cur = {}, o
    while cur and cur ~= root do
      local idx = 1
      for _, x in ipairs(cur.Parent:GetChildren()) do
        if x == cur then break end
        if x.Name == cur.Name then idx += 1 end
      end
      table.insert(parts, 1, cur.Name .. "#" .. idx)
      cur = cur.Parent
    end
    return table.concat(parts, "/")
  end
  local function walk(node, depth)
    for _, c in ipairs(node:GetChildren()) do
      if (c:IsA("GuiObject") or c:IsA("LayerCollector")) and c.Name ~= "WxDbg" and not c.Name:find("^SkyP") then
        local t = { c.ClassName }
        pcall(function()
          if c:IsA("GuiObject") then
            t[#t + 1] = "vis=" .. tostring(c.Visible)
            t[#t + 1] = "bg=" .. tostring(c.BackgroundColor3)
            t[#t + 1] = "bgt=" .. string.format("%.2f", c.BackgroundTransparency)
          end
          if c:IsA("ImageLabel") or c:IsA("ImageButton") then
            t[#t + 1] = "img=" .. tostring(c.Image)
            t[#t + 1] = "imgc=" .. tostring(c.ImageColor3)
          end
        end)
        s[pathOf(c)] = table.concat(t, " ")
        if c.Name ~= "Tiles" and c.Name ~= "PlayerView" and depth < 5 then walk(c, depth + 1) end
      end
    end
  end
  walk(root, 1)
  return s
end

btn("A: normal", 90, function()
  snap = snapshot()
  local n = 0; for _ in pairs(snap) do n += 1 end
  show("Snapshot A tersimpan di memori: " .. n .. " objek.\nSekarang ubah weather lewat machine, lalu tekan 'B: selisih'.")
end)

btn("B: selisih", 100, function()
  if not snap then show("Tekan 'A: normal' dulu.") return end
  local new, diff = snapshot(), {}
  for p, d in pairs(new) do
    if snap[p] == nil then diff[#diff + 1] = "NEW  " .. p .. " | " .. d
    elseif snap[p] ~= d then diff[#diff + 1] = "CHG  " .. p .. "\n  A: " .. snap[p] .. "\n  B: " .. d end
  end
  for p in pairs(snap) do if new[p] == nil then diff[#diff + 1] = "GONE " .. p end end
  table.sort(diff)
  local text = "Selisih: " .. #diff .. "\n\n" .. table.concat(diff, "\n")
  if hasFS then pcall(writefile, "Fian/weather_diff.txt", text) end
  show(text)
end)

btn("Scan modul", 90, function()
  if type(getloadedmodules) ~= "function" then show("Executor tidak punya getloadedmodules.") return end
  local pats = { "rainy", "snowy", "warp", "digital rain", "weather" }
  local function hit(s)
    s = s:lower()
    for _, p in ipairs(pats) do if s:find(p, 1, true) then return true end end
  end
  local out = {}
  for _, m in ipairs(getloadedmodules()) do
    local ok, v = pcall(require, m)
    if ok and type(v) == "table" then
      local found = {}
      local function scan(t, d, pre)
        if d > 3 or #found > 15 then return end
        for k, val in pairs(t) do
          if type(k) == "string" and hit(k) then found[#found + 1] = pre .. k end
          if type(val) == "string" and #val < 60 and hit(val) then found[#found + 1] = pre .. tostring(k) .. "=" .. val end
          if type(val) == "table" and val ~= t then pcall(scan, val, d + 1, pre .. tostring(k) .. ".") end
        end
      end
      pcall(scan, v, 1, "")
      if #found > 0 then out[#out + 1] = m:GetFullName() .. " -> " .. table.concat(found, ", ") end
    end
  end
  local text = #out > 0 and table.concat(out, "\n") or "Tidak ada modul yang cocok."
  if hasFS then pcall(writefile, "Fian/weather_modules.txt", text) end
  show(text)
end)

